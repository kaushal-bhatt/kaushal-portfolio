// Postgres — the same instance that runs auth-platform, in its own `portfolio`
// database. There is no second schema file: this one is used everywhere, so
// development and production cannot drift apart the way they did when a
// switch-schema.sh script swapped a SQLite file in and out.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// There are no user, account or session tables here any more.
//
// Admin sign-in moved to auth-platform: this app verifies a JWT against that
// service's public keys and reads a role out of it. It stores no credentials, no
// password hashes and no sessions — so there is nothing here for a leaked secret
// or a database dump to give away. The previous arrangement kept an admin
// password hash in a committed SQLite file and signed its own session cookie
// with a secret that was published in this repository.
//
// See IdeaProjects/PORTFOLIO-SSO-PLAN.md.
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Content. `technologies`, `achievements` and `tags` are real Postgres text
// arrays. They were comma-joined strings under SQLite purely because SQLite has
// no array type — a limitation there is no reason to carry over. Splitting on a
// comma also quietly corrupted any value that contained one.
// ---------------------------------------------------------------------------

model Portfolio {
  id           String   @id @default(cuid())
  company      String
  role         String
  startDate    String
  endDate      String?
  current      Boolean  @default(false)
  description  String   @db.Text
  technologies String[] @default([])
  achievements String[] @default([])
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Open-source projects — the /portfolio page.
///
/// Separate from `Portfolio`, which despite its name holds *work experience*
/// (company, role, dates). That naming is confusing and predates this; the two
/// really are different things, which is why this is its own table rather than
/// a flag on that one.
model Project {
  id          String @id @default(cuid())
  title       String @unique
  description String @db.Text

  technologies String[] @default([])

  /// Null when there is nothing to click. The page hides the button rather than
  /// linking somewhere that does not exist.
  demoUrl   String?
  githubUrl String

  status   String @default("Open Source")
  category String

  /// Featured projects render in the larger two-column grid above the rest.
  featured Boolean @default(false)

  /// Kept as text ("2026-08"). It is a label on a card, never sorted or compared
  /// as a date, and storing it as one would invite a timezone question that has
  /// no answer here.
  completionDate String

  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id         String  @id @default(cuid())
  title      String
  slug       String  @unique
  excerpt    String  @db.Text
  content    String  @db.Text
  technology String
  published  Boolean @default(false)

  // A byline, not a foreign key. There is no user table to point at, and on a
  // single-author blog the author was never really a relationship — it was a
  // label that happened to be stored somewhere else.
  authorName String @default("Kaushal Bhatt")

  tags      String[] @default([])
  readTime  Int      @default(5)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TechSection {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String   @db.Text
  icon        String
  order       Int      @default(0)
  /// A key into `lib/tech-visuals.ts`, not a hex value. It held a raw hex
  /// string that three components fetched and none rendered.
  color       String   @default("blue")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// The About section. It was three hardcoded arrays in
// `components/about-section.tsx` — the prose, the skill cards and the four
// figures — so changing a number meant a commit and a deploy. Three tables
// rather than one because they are three different shapes, and because the
// prose is a singleton while the other two are lists the admin adds to.
// ---------------------------------------------------------------------------

/// One row, always. `id` defaults to "main" and the admin route upserts on that
/// rather than creating a second row every time the copy is edited.
model AboutContent {
  id String @id @default("main")

  /// The heading is split so the accent keeps its gradient: "About" + "Me".
  heading       String @default("About")
  headingAccent String @default("Me")

  /// The line under the heading.
  subtitle String @db.Text

  journeyTitle String @default("My Journey")

  /// Markdown, rendered with `lib/markdown.ts` — the same subset the blog uses.
  /// Stored as markdown rather than HTML because that renderer escapes its input
  /// first, so a link written as [text](url) survives and a `<script>` does not.
  journey String @db.Text

  updatedAt DateTime @updatedAt
}

/// A skill card: a heading, an icon, and the bullet list under it.
model AboutSkill {
  id       String   @id @default(cuid())
  category String   @unique
  /// A key into `lib/about-visuals.ts`, not a class name and not an import path.
  icon     String   @default("Code2")
  items    String[] @default([])
  /// Also a key into that file. Tailwind never sees database values, so a raw
  /// `text-orange-400` stored here would be purged and do nothing.
  color    String   @default("blue")
  order    Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One of the four figures along the bottom ("7 Years", "57%", …).
///
/// Not called `achievement`: `Portfolio.achievements` already exists and means
/// something else entirely — the bullet points under a job.
model AboutStat {
  id          String @id @default(cuid())
  label       String @unique
  description String
  icon        String @default("Award")
  order       Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// The résumés behind /resume.
//
// Many rows, not one. It started as a singleton like AboutContent, which was
// wrong for the thing it holds: a CV is edited by replacing it, and the version
// you just replaced is the one you want back when the next application goes
// badly. Keeping old rows unpublished makes the history free, and it is the
// same mechanism that lets a second, differently-angled CV exist alongside the
// first — one aimed at platform roles, one at data.
//
// Separate from `Portfolio` even though both describe the same jobs: the site
// wants paragraphs and the CV wants one-line bullets that lead with the result.
// Serving both from one column produced a page that read like a CV and a CV
// that read like a page.
//
// The structured parts are `Json` rather than more tables because nothing ever
// queries into them: the whole record is read at once to render one document,
// and a bullet list has no identity outside the job it belongs to.
// ---------------------------------------------------------------------------
model Resume {
  id String @id @default(cuid())

  /// The URL: /resume/senior-backend-engineer.
  slug String @unique

  /// Shown on the button that links to it, and in the admin list. It is what
  /// tells two versions apart, so it carries a date or an angle rather than
  /// just saying "Résumé" twice.
  label String

  /// Unpublished means gone from the public site entirely — every link to it
  /// disappears, and the page 404s rather than 403s. A 403 would confirm the
  /// address exists.
  published Boolean @default(false)

  /// Decides which one /resume redirects to when several are published.
  order Int @default(0)

  fullName String
  headline String
  location String
  email    String

  /// Printed copy only. The page is public, and a phone number on a public page
  /// is a scraper target; a recruiter who has the PDF has the number.
  phone String?

  linkedin String
  github   String
  website  String

  /// Around fifty words. The ATS reads this first and so does a human.
  summary String @db.Text

  /// [{ label, items }] — items is one comma-separated string, which is what an
  /// ATS parses cleanly and what a reader scans fastest.
  skills Json

  /// [{ company, role, period, location, context, bullets: [] }]
  experience Json

  /// [{ name, tagline, liveUrl, repoUrl }] — every one of these is running
  /// somewhere a reader can click, which is the point of listing them.
  projects Json

  /// [{ degree, institution, location, period }]
  education Json

  certifications String @db.Text
  languages      String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// The "book a call" section.
//
// One row, like AboutContent. Its own table rather than three more columns on
// that one because it drives a separate section of the page — putting it there
// would mean "About" was the place you go to edit something that is not the
// About section.
//
// An empty `calendlyUrl` is the off switch: the section disappears, the
// navigation entry with it, and no third-party script is ever requested. That
// is also the state a fresh database starts in, so nothing has to be
// configured for the site to be correct.
// ---------------------------------------------------------------------------
model Booking {
  id String @id @default("main")

  /// The full Calendly URL, e.g. https://calendly.com/kaushal/30min.
  /// Empty means the whole section is off.
  calendlyUrl String @default("")

  heading       String @default("Book")
  headingAccent String @default("a Call")
  subtitle      String @default("") @db.Text

  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// The site itself — everything that was a string literal in a component.
//
// The hero, the navigation brand, the footer, every section heading, the
// contact links and the page metadata all lived in source until now, so
// changing a tagline was a commit and a deploy.
//
// `host` and `isDefault` exist from the first row, even though there is only
// one. They are the seam: when a second portfolio arrives it is a row here and
// a DNS record, not a rewrite. Resolution already works — it just always finds
// the same site today.
//
// The small chrome strings are deliberately NOT here: "Read", "Source Code",
// "View All Articles", "min read". They are UI, identical for anybody, and
// putting them in the database would turn one form into a translation table.
// ---------------------------------------------------------------------------
model Site {
  id String @id @default(cuid())

  /// The hostname this site answers on, e.g. "wekt.in". No scheme, no port.
  host String @unique

  /// Where an unrecognised Host lands. Exactly one row should have this.
  isDefault Boolean @default(false)

  // --- identity -------------------------------------------------------------
  fullName     String
  /// The line under the name: "Senior Backend Engineer · 7 years".
  headline     String @default("")
  locationLine String @default("")
  /// The navigation brand. Usually the name, but not always.
  navBrand     String @default("")

  // --- hero -----------------------------------------------------------------
  heroGreeting String @default("Hi, I'm")

  /// Markdown, rendered with `lib/markdown.ts` — the same escape-first subset
  /// the blog and the About journey use. Markdown rather than HTML so the
  /// company names keep their emphasis without the column being able to inject.
  heroIntro String @default("") @db.Text

  primaryCtaLabel String @default("View My Work")

  /// The middle hero button. Empty hides it — the pattern Booking.calendlyUrl
  /// established, and the reason there is no separate boolean.
  demoUrl   String @default("")
  demoLabel String @default("")

  // --- contact --------------------------------------------------------------
  // Each is empty-means-hidden. A site with no GitHub should show no icon
  // rather than an icon linking to a 404.
  email       String @default("")
  linkedinUrl String @default("")
  githubUrl   String @default("")

  // --- footer ---------------------------------------------------------------
  footerTagline String @default("") @db.Text

  // --- section copy ---------------------------------------------------------
  // Heading and accent are split for the same reason AboutContent splits them:
  // the accent half carries the gradient.
  experienceHeading       String @default("Professional")
  experienceHeadingAccent String @default("Experience")
  experienceSubtitle      String @default("") @db.Text

  projectsHeading       String @default("My")
  projectsHeadingAccent String @default("Portfolio")
  projectsSubtitle      String @default("") @db.Text

  blogHeading       String @default("Technical")
  blogHeadingAccent String @default("Blog")
  blogSubtitle      String @default("") @db.Text

  /// The /blog page has its own H1 and its own line under it, which today say
  /// something slightly different from the home page's blog section.
  blogPageHeading       String @default("Technical")
  blogPageHeadingAccent String @default("Blog")
  blogPageSubtitle      String @default("") @db.Text

  contactHeading  String @default("")
  contactSubtitle String @default("") @db.Text

  // --- SEO ------------------------------------------------------------------
  metaTitle       String   @default("")
  metaDescription String   @default("") @db.Text
  metaKeywords    String[] @default([])
  /// Absolute URL. Empty falls back to the app's generated OG image.
  ogImageUrl      String   @default("")

  // --- theme ----------------------------------------------------------------
  /// A key into ACCENTS in `lib/site.ts`, never a class string. Tailwind reads
  /// source and never the database, so a stored `from-blue-400` would name a
  /// class that was purged at build time and the gradient would silently
  /// vanish. Same reasoning as `lib/about-visuals.ts`.
  accent String @default("blue")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
