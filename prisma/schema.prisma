// Postgres — the same instance that runs auth-platform, in its own `portfolio`
// database. There is no second schema file: this one is used everywhere, so
// development and production cannot drift apart the way they did when a
// switch-schema.sh script swapped a SQLite file in and out.

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// There are no user, account or session tables here any more.
//
// Admin sign-in moved to auth-platform: this app verifies a JWT against that
// service's public keys and reads a role out of it. It stores no credentials, no
// password hashes and no sessions — so there is nothing here for a leaked secret
// or a database dump to give away. The previous arrangement kept an admin
// password hash in a committed SQLite file and signed its own session cookie
// with a secret that was published in this repository.
//
// See IdeaProjects/PORTFOLIO-SSO-PLAN.md.
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Content. `technologies`, `achievements` and `tags` are real Postgres text
// arrays. They were comma-joined strings under SQLite purely because SQLite has
// no array type — a limitation there is no reason to carry over. Splitting on a
// comma also quietly corrupted any value that contained one.
// ---------------------------------------------------------------------------

model Portfolio {
  id           String   @id @default(cuid())
  company      String
  role         String
  startDate    String
  endDate      String?
  current      Boolean  @default(false)
  description  String   @db.Text
  technologies String[] @default([])
  achievements String[] @default([])
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model BlogPost {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  excerpt    String   @db.Text
  content    String   @db.Text
  technology String
  published  Boolean  @default(false)

  // A byline, not a foreign key. There is no user table to point at, and on a
  // single-author blog the author was never really a relationship — it was a
  // label that happened to be stored somewhere else.
  authorName String   @default("Kaushal Bhatt")

  tags       String[] @default([])
  readTime   Int      @default(5)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TechSection {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String   @db.Text
  icon        String
  order       Int      @default(0)
  color       String   @default("#3B82F6")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
