# Copy to `.env` and fill in. `.env` is gitignored — never commit the real one.
#
# Nothing in this project falls back to a default secret any more. If one of the
# required values below is missing, the app or compose fails with a clear error
# instead of quietly coming up with a value that is published in this repository.

# ---- Database -----------------------------------------------------------------
# Local: compose brings up Postgres and builds this URL for you; you only need to
# set POSTGRES_PASSWORD. Running `prisma`/`next` outside compose, point at the
# mapped host port 5433:
#   DATABASE_URL=postgresql://portfolio:<password>@localhost:5433/portfolio
POSTGRES_PASSWORD=
#POSTGRES_DB=portfolio
#POSTGRES_USER=portfolio
DATABASE_URL=

# ---- Admin sign-in, via auth-platform -----------------------------------------
# There is no local authentication. Signing in happens on auth-platform, which
# hands this app a signed JWT; all this app does is verify it against that
# service's public keys. It stores no passwords and signs nothing, so unlike the
# NEXTAUTH_SECRET this replaces, there is no secret here whose leak forges a
# session.

# Where the auth service lives. Also where its JWKS is fetched from.
AUTH_PLATFORM_URL=https://auth.wekt.in

# This app's own public base URL. The redirect URI is built from it, and
# auth-platform matches that URI by exact string equality — so a mismatch here
# (a trailing slash, http vs https) fails the exchange rather than half-working.
PORTFOLIO_BASE_URL=http://localhost:3000

# Must match the client_id and secret registered on auth-platform under
# auth-platform.sso.clients.<id>. The secret is used server-to-server only and
# must never reach a browser.
AUTH_PLATFORM_SSO_CLIENT_ID=portfolio
AUTH_PLATFORM_SSO_CLIENT_SECRET=

# The role an account must hold to reach /admin. Registration on auth-platform's
# demo is open to anyone, so without this "signed in" would mean "signed up".
# Optional; defaults to portfolio-admin.
#AUTH_PLATFORM_SSO_REQUIRED_ROLE=portfolio-admin

# Checked on every token, not merely read — without them any token that JWKS can
# validate would be accepted, including one minted for a different application.
# Optional; these are auth-platform's defaults.
#AUTH_PLATFORM_ISSUER=auth-service
#AUTH_PLATFORM_AUDIENCE=auth-platform-client

# ---- Seeding ------------------------------------------------------------------
# `npm run db:seed` skips any table that already has rows, so it can never wipe
# content the way the original seed script did. Set this to replace them anyway.
#SEED_FORCE=true
