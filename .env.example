# Copy to `.env` and fill in. `.env` is gitignored — never commit the real one.
#
# Nothing in this project falls back to a default secret any more. If one of the
# required values below is missing, the app or compose fails with a clear error
# instead of quietly coming up with a value that is published in this repository.

# ---- Database -----------------------------------------------------------------
# Local: compose brings up Postgres and builds this URL for you; you only need to
# set POSTGRES_PASSWORD. Running `prisma`/`next` outside compose, point at the
# mapped host port 5433:
#   DATABASE_URL=postgresql://portfolio:<password>@localhost:5433/portfolio
POSTGRES_PASSWORD=
#POSTGRES_DB=portfolio
#POSTGRES_USER=portfolio
DATABASE_URL=

# ---- NextAuth -----------------------------------------------------------------
# Signs the session cookie. Generate a fresh one and keep it out of git:
#   openssl rand -base64 32
#
# NOTE: this whole variable is on its way out. Admin login is moving to
# auth-platform SSO (see IdeaProjects/PORTFOLIO-SSO-PLAN.md, Phase 2), after
# which the app holds auth-platform's JWT in an httpOnly cookie and verifies it
# against JWKS — nothing is signed locally, so there is no secret to leak.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ---- Seeding ------------------------------------------------------------------
# Email for the row that owns the blog posts. It has NO password — it cannot log
# in. Optional; defaults to author@wekt.in.
#ADMIN_EMAIL=

# `npm run db:seed` skips any table that already has rows, so it can never wipe
# content the way the previous seed script did. Set this to replace them anyway.
#SEED_FORCE=true
